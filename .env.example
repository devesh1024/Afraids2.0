DATABASE_URL=sqlite:///./afraids.db
LOG_LEVEL=INFO

# --- Phase 3: agentic workflow ---
AGENT_MODE=workflow            # workflow (Phase 3 multi-agent) | legacy (Phase 1/2 pipeline)
AGENT_MAX_ITERATIONS=3         # bounded investigation loop (hard ceiling 10)
AGENT_MAX_TOOL_CALLS=80        # per-investigation tool-call budget
AGENT_CONFIDENCE_THRESHOLD=0.6 # below this the incident is marked NEEDS_REVIEW
AGENT_STEP_DELAY_MS=300        # demo: pause after an agent starts so RUNNING is visible in the UI (0 = off)
